{
  "name": "sensor_hub_ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "generate:api": "openapi-typescript ../../api/openapi.yaml -o src/gen/schema.d.ts",
    "lint": "eslint . && eslint --no-inline-config --config eslint.inline-guard.config.js src",
    "preview": "vite preview",
    "test": "vitest run",
    "test:layout": "npm run build && playwright test"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-data-grid": "^9.14.0",
    "@mui/x-date-pickers": "^9.14.0",
    "formik": "^2.4.6",
    "luxon": "^3.7.1",
    "openapi-fetch": "^0.17.0",
    "openmeteo": "^1.2.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-grid-layout": "^2.2.4",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "swagger-ui-react": "^5.33.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "openapi-typescript": "^7.13.0",
    "openapi-typescript-helpers": "^0.1.0",
    "typescript": "~6.0.3",
