# map must be in the http context; this file is included into nginx's http context
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 80;
    server_name _;

    # Redirect all HTTP to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name _;

    ssl_certificate /etc/ssl/certs/home.sensor-hub.pem;
    ssl_certificate_key /etc/ssl/private/home.sensor-hub-key.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # Metrics are unauthenticated, so they are never proxied. Prometheus scrapes
    # them from metrics.listen.address (127.0.0.1:9464) instead.
    location = /metrics {
        return 404;
    }

    # Everything else is served by the Go binary (API, WebSocket, and embedded UI).
    # Nginx only handles TLS termination. Sensor Hub believes the forwarded
    # client address only because http.trusted.proxies lists 127.0.0.1 and ::1.
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# --- MQTT over TLS on port 8883 (optional) ---------------------------------
#
# Only for the public-port way of connecting home devices. A tunnel is
# preferred and needs none of this. See "Connecting your home" in the docs.
#
# A stream block cannot live in this file: nginx includes this file inside its
# http context, and stream must sit at the top level. To use it, copy the block
# below, without the leading "# ", into a file of its own, such as
# /etc/nginx/sensor-hub-stream.conf, and include that file at the top level of
# /etc/nginx/nginx.conf, outside the http block:
#
#     include /etc/nginx/sensor-hub-stream.conf;
#
# The stream module is a separate package on most distributions:
#     Debian / Ubuntu:  sudo apt install libnginx-mod-stream
#     Fedora / RHEL:    sudo dnf install nginx-mod-stream
# Then check the configuration with: sudo nginx -t
#
# stream {
#     # At most 5 open connections from one client address at a time.
#     limit_conn_zone $binary_remote_addr zone=sensor_hub_mqtt_conn:10m;
#
#     server {
#         listen 8883 ssl;
#
#         # The same certificate as HTTPS above.
#         ssl_certificate /etc/ssl/certs/home.sensor-hub.pem;
#         ssl_certificate_key /etc/ssl/private/home.sensor-hub-key.pem;
#         ssl_protocols TLSv1.2 TLSv1.3;
#
#         limit_conn sensor_hub_mqtt_conn 5;
#
#         # The embedded broker on its default listen address. The rate of new
#         # CONNECTs is bounded by the hub's mqtt.broker.connect.rate.limit,
#         # before authentication; nginx has no limit_req for streams.
#         proxy_pass 127.0.0.1:1883;
#         proxy_connect_timeout 5s;
#         proxy_timeout 10m;
#     }
# }
